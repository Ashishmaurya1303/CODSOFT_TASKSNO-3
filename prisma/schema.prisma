// FleetFlow — Logistics & Fleet Management Database Schema
// Prisma ORM with PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DRIVER
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  INACTIVE
}

enum VehicleType {
  VAN
  TRUCK
  TRAILER
  EV_VAN
}

enum VehicleStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
}

enum ShipmentStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  phone     String?
  driver    Driver?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Driver {
  id               String       @id @default(cuid())
  userId           String?      @unique
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  name             String
  email            String?
  phone            String
  licenseNumber    String       @unique
  vehicleType      String?      // e.g., "Heavy Cargo Truck", "Express Van"
  status           DriverStatus @default(AVAILABLE)
  rating           Float        @default(4.8)
  emergencyContact String?
  shipments        Shipment[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status])
  @@index([licenseNumber])
}

model Vehicle {
  id              String        @id @default(cuid())
  plateNumber     String        @unique
  model           String
  type            VehicleType   @default(TRUCK)
  capacityKg      Float
  fuelType        String?       // Diesel, Electric, CNG, Petrol
  status          VehicleStatus @default(AVAILABLE)
  currentLocation String?
  shipments       Shipment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([plateNumber])
}

model Warehouse {
  id                    String     @id @default(cuid())
  name                  String
  code                  String     @unique // e.g., WH-MUM-01
  address               String
  city                  String
  state                 String
  pincode               String
  capacityKg            Float      @default(100000)
  currentLoadKg         Float      @default(0)
  managerName           String
  contactPhone          String
  latitude              Float
  longitude             Float
  originShipments       Shipment[] @relation("OriginWarehouse")
  destinationShipments  Shipment[] @relation("DestinationWarehouse")
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([code])
  @@index([city])
}

model Shipment {
  id                String            @id @default(cuid())
  trackingId        String            @unique // e.g., FF-89210-IN
  senderName        String
  senderPhone       String
  senderAddress     String
  senderCity        String
  recipientName     String
  recipientPhone    String
  recipientAddress  String
  recipientCity     String
  recipientPincode  String
  
  originWarehouseId String?
  originWarehouse   Warehouse?        @relation("OriginWarehouse", fields: [originWarehouseId], references: [id], onDelete: SetNull)
  
  destWarehouseId   String?
  destWarehouse     Warehouse?        @relation("DestinationWarehouse", fields: [destWarehouseId], references: [id], onDelete: SetNull)
  
  driverId          String?
  driver            Driver?           @relation(fields: [driverId], references: [id], onDelete: SetNull)
  
  vehicleId         String?
  vehicle           Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  
  status            ShipmentStatus    @default(PENDING)
  priority          Priority          @default(MEDIUM)
  weightKg          Float
  packageType       String            // Box, Pallet, Fragile, Perishable, Electronics
  
  estimatedDelivery DateTime
  actualDelivery    DateTime?
  
  currentLocation   String?
  currentLat        Float?
  currentLng        Float?
  notes             String?
  
  statusHistory     ShipmentStatusHistory[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([trackingId])
  @@index([status])
  @@index([priority])
  @@index([driverId])
  @@index([vehicleId])
}

model ShipmentStatusHistory {
  id         String         @id @default(cuid())
  shipmentId String
  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     ShipmentStatus
  location   String?
  notes      String?
  updatedBy  String?        // Admin, Driver name, or Automated
  timestamp  DateTime       @default(now())

  @@index([shipmentId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?  // null means broadcast to all admins
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, ALERT
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}
